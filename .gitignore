# Build output
/dist/
/md/

# Everything the binary embeds is produced or fetched by build/Dockerfile.build,
# never committed: the OpenTelemetry agent is 25MB, the OBI eBPF binary is 113MB
# and architecture-specific, and the bootstrap jar and attach helper are compiled
# from the source already in this repository.
/internal/assets/files/*.jar
/internal/ebpf/files/obi
/internal/attachhelper/files/apm2go-attach-helper
/agent/bootstrap/build/

# The web build output is embedded by the Go build, never committed: a built
# index.html names hashed asset files, so committing it would produce binaries
# whose UI references assets that are not in the repository. Only the directory
# is tracked, because the embed directive needs it to exist; a binary built
# without the web stage serves a clear "UI was not built" message.
/internal/api/dist/*
!/internal/api/dist/.gitkeep

# Node
/web/node_modules/
/web/.vite/
/web/*.tsbuildinfo

# Local data
*.duckdb
*.duckdb.wal

# Stray archives and macOS finder metadata
*.tar
.DS_Store
