# Acceptance test: install apm2go from its RPM on a clean distribution and
# verify it instruments a four-service chain that is already running.
#
# This is deliberately not the build image. It proves the package stands on its
# own — no Go toolchain, no jars staged by hand, no JDK that apm2go brought
# along — and the workload it instruments carries no tracing code of its own.
FROM rockylinux:9

# curl is already present as curl-minimal in the base image; asking for the
# full package would conflict with it. The JRE is headless and has no compiler,
# matching a host that runs Java rather than builds it: the workload is
# compiled outside and copied in as classes.
RUN dnf install -y java-21-openjdk-headless procps-ng && dnf clean all

WORKDIR /opt/chain
COPY build/chain/lib /opt/chain/lib
COPY build/chain/classes /opt/chain/classes
COPY build/chain/start-chain.sh /opt/chain/start-chain.sh
RUN chmod +x /opt/chain/start-chain.sh

ARG RPM_FILE
COPY dist/${RPM_FILE} /tmp/apm2go.rpm
RUN rpm -i /tmp/apm2go.rpm && rm -f /tmp/apm2go.rpm

# The chain starts first and keeps running; whatever is passed as the command
# starts afterwards, against processes that are already serving traffic.
ENTRYPOINT ["/bin/bash", "-c", "/opt/chain/start-chain.sh && sleep 5 && exec \"$@\"", "--"]
